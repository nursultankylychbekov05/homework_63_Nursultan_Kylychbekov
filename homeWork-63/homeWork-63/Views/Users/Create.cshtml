@model homeWork_63.Models.User

@{
    ViewData["Title"] = "Создать пользователя";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="text-center mb-4">Создать пользователя</h2>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Имя пользователя</label>
                        <input name="userName" class="form-control" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дата рождения</label>
                        <input name="birthDate" type="date" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Аватар</label>
                        <input name="avatarFile" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пароль</label>
                        <input name="password" type="password" class="form-control" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary">Создать</button>
                        <a asp-action="AdminPanel" class="btn btn-secondary">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>