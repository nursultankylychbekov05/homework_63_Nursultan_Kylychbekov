@model IEnumerable<homeWork_63.Models.User>

@{
    ViewData["Title"] = "Панель администратора";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Панель администратора</h2>
            <p class="text-muted mb-0">Управление пользователями системы</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Создать пользователя</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Аватар</th>
                    <th>Имя пользователя</th>
                    <th>Email</th>
                    <th>Дата рождения</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    bool isLocked = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow;
                    <tr>
                        <td class="text-center">
                            <img src="@user.Avatar" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                        </td>
                        <td>
                            <a asp-controller="Users" asp-action="Profile" asp-route-id="@user.Id" class="text-decoration-none fw-bold">
                                @user.UserName
                            </a>
                        </td>
                        <td>@user.Email</td>
                        <td>@user.BirthDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (isLocked)
                            {
                                <span class="badge bg-danger">Заблокирован</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Изменить</a>
                            
                            <form asp-action="ToggleBlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                @if (isLocked)
                                {
                                    <button type="submit" class="btn btn-sm btn-success">Разблокировать</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-danger">Заблокировать</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-controller="Chat" asp-action="Index" class="btn btn-secondary">Вернуться в чат</a>
    </div>
</div>