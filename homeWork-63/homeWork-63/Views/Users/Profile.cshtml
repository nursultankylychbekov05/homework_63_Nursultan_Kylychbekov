@model homeWork_63.Models.User

@{
    ViewData["Title"] = "Профиль: " + Model.UserName;
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm p-4 text-center">
            <div class="mb-3">
                <img src="@Model.Avatar" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" />
            </div>
            <h3>@Model.UserName</h3>
            <p class="text-muted">@Model.Email</p>
            <p><strong>Дата рождения:</strong> @Model.BirthDate.ToString("dd.MM.yyyy")</p>
            <div class="alert alert-secondary mt-3">
                Отправлено сообщений в чате: <strong>@ViewBag.MessageCount</strong>
            </div>
            
            @if (ViewBag.IsCurrentUser == true)
            {
                <div class="mt-3">
                    <a asp-action="EditProfile" class="btn btn-primary">Редактировать профиль</a>
                </div>
            }

            <div class="mt-3">
                <a asp-controller="Chat" asp-action="Index" class="btn btn-primary">Вернуться в чат</a>
            </div>
        </div>
    </div>
</div>