@model homeWork_63.Models.User

@{
    ViewData["Title"] = "Редактировать пользователя";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="text-center mb-4">Редактировать пользователя</h2>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="text-center mb-3">
                        <img src="@Model.Avatar" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Имя пользователя</label>
                        <input name="userName" value="@Model.UserName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" value="@Model.Email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дата рождения</label>
                        <input name="birthDate" type="date" value="@Model.BirthDate.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Новый аватар (необязательно)</label>
                        <input name="avatarFile" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-success">Сохранить</button>
                        <a asp-action="AdminPanel" class="btn btn-secondary">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>