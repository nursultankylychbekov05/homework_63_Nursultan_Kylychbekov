@model homeWork_63.Models.LoginViewModel

@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h2 class="text-center mb-3">Вход в систему</h2>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="LoginOrEmail" class="form-label"></label>
                <input asp-for="LoginOrEmail" class="form-control" />
                <span asp-validation-for="LoginOrEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" id="loginPasswordInput" />
                    <button class="btn btn-outline-secondary" type="button" id="toggleLoginPassword">👁</button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Войти</button>
        </form>
        <div class="text-center mt-3">
            <a asp-action="Register">Нет аккаунта? Зарегистрироваться</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleLoginPassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('loginPasswordInput');
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            this.textContent = type === 'password' ? '👁' : '👁‍🗨';
        });
    </script>
}